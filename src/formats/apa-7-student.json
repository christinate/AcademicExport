{
  "schemaVersion": 1,
  "id": "apa-7-student",
  "name": "APA 7 Student",
  "description": "APA Seventh Edition student paper.",
  "templateFile": "templates/apa-7-student.md",
  "fields": [
    { "key": "Title", "label": "Title", "type": "string", "required": true, "description": "Full paper title." },
    { "key": "Author", "label": "Author", "type": "string-list", "required": true, "description": "Author name or names.", "aliases": ["Authors"] },
    { "key": "Affiliation", "label": "Department and institution", "type": "string", "required": true, "description": "Department and school or organization.", "aliases": ["School", "Organization"] },
    { "key": "Course", "label": "Course", "type": "string", "required": true, "description": "Course number and name." },
    { "key": "Instructor", "label": "Instructor", "type": "string", "required": true, "description": "Instructor name." },
    { "key": "DueDate", "label": "Due date", "type": "date", "required": true, "description": "Assignment due date.", "aliases": ["Date"] },
    { "key": "Abstract", "label": "Abstract", "type": "markdown", "required": false, "description": "Optional abstract if requested." },
    { "key": "Keywords", "label": "Keywords", "type": "string-list", "required": false, "description": "Optional keywords." }
  ],
  "options": [
    { "key": "includeTitlePage", "label": "Include title page", "description": "Create the APA student title page.", "default": true },
    { "key": "includeAbstract", "label": "Include abstract", "description": "Include an abstract page when requested by the instructor.", "default": false }
  ],
  "rules": { "size": "letter", "marginInches": 1, "fontFamily": "Times New Roman", "fontSizePoints": 12, "lineSpacing": 2, "paragraphIndentInches": 0.5, "pageNumbers": true, "runningHead": false },
  "sections": [
    { "key": "Body", "label": "Paper body", "required": true },
    { "key": "References", "label": "References", "required": true, "pageBreakBefore": true }
  ],
  "variants": [
    { "id": "general-student", "name": "General Student Paper", "description": "Standard course paper with instructor-defined content sections.", "recommendedSections": [], "abstractDefault": false },
    { "id": "annotated-bibliography", "name": "Annotated Bibliography", "description": "Bibliographic entries followed by evaluative or descriptive annotations.", "recommendedSections": ["Annotated Bibliography"], "abstractDefault": false },
    { "id": "design-project", "name": "Design Project", "description": "Design background, process, results, figures, and supporting references.", "recommendedSections": ["Abstract", "Topic Background", "Design Process", "Results", "References"], "abstractDefault": true },
    { "id": "discussion-post", "name": "Discussion Post", "description": "Concise course discussion response with references when used.", "recommendedSections": ["References"], "abstractDefault": false },
    { "id": "journalism-assignment", "name": "Journalism Assignment", "description": "Journalism or media assignment using APA citations and references.", "recommendedSections": ["References"], "abstractDefault": false },
    { "id": "literature-review", "name": "Literature Review", "description": "Thematic synthesis of existing research.", "recommendedSections": ["Thematic Review", "Conclusion", "References"], "abstractDefault": false },
    { "id": "quantitative-study", "name": "Quantitative Study", "description": "Empirical quantitative report organized around method, results, and discussion.", "recommendedSections": ["Abstract", "Method", "Participants", "Materials", "Procedure", "Results", "Discussion", "References"], "abstractDefault": true }
  ]
}
