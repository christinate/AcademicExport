{
  "schemaVersion": 1, "id": "ieee-conference", "name": "IEEE Conference", "description": "IEEE conference manuscript with two-column body.", "templateFile": "templates/ieee-conference.md",
  "fields": [
    { "key": "Title", "label": "Title", "type": "string", "required": true, "description": "Specific, concise paper title." },
    { "key": "Author", "label": "Author", "type": "string-list", "required": true, "description": "Author names." },
    { "key": "Affiliation", "label": "Affiliation", "type": "string-list", "required": true, "description": "Author affiliations." },
    { "key": "Abstract", "label": "Abstract", "type": "markdown", "required": true, "description": "Self-contained abstract of no more than 250 words." },
    { "key": "Keywords", "label": "Keywords", "type": "string-list", "required": true, "description": "Three to five index terms." }
  ],
  "options": [{ "key": "includeAbstract", "label": "Include abstract and index terms", "description": "Include the abstract and keywords beneath the author block.", "default": true }],
  "rules": { "size": "letter", "marginInches": 0.75, "fontFamily": "Times New Roman", "fontSizePoints": 10, "lineSpacing": 1, "paragraphIndentInches": 0.16, "pageNumbers": false, "runningHead": false },
  "sections": [{ "key": "Body", "label": "Two-column paper body", "required": true }, { "key": "References", "label": "References", "required": true }],
  "variants": [{ "id": "standard-conference-paper", "name": "Standard Conference Paper", "description": "Standard IEEE conference research manuscript.", "recommendedSections": ["Introduction", "Method", "Results", "Conclusion"], "abstractDefault": true }]
}
